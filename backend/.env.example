# Required — used by property_llm.py
OPENAI_API_KEY=sk-...

# Optional — only set these if server.py or properties.db live somewhere
# other than the defaults (server.py next to real_estate_client.py, and
# database/properties.db next to server.py).
# REAL_ESTATE_MCP_SERVER_PATH=/opt/ashray/server.py
# REAL_ESTATE_DB_PATH=/opt/ashray/database/properties.db

# Only needed if you also run whatsapp_webhook.py on this server.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
